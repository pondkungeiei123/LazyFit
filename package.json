    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@tailwindcss/vite": "4.1.13",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/sql.js": "1.4.9",
